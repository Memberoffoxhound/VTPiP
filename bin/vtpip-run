#!/bin/bash
# Steam shortcut target. Launching this from Game Mode puts VacuumTube in the
# Steam running-apps list so the controller can switch to it.
set -euo pipefail

export PATH="/usr/bin:/usr/local/bin:/bin:${HOME}/.local/bin:${PATH:-}"

APP="rocks.shy.VacuumTube"
# ozone x11: gamescope Xwayland. DevTools 9224 is the overlay's backup capture.
# The disable-background* flags keep YouTube painting while a game is focused
# (otherwise Chromium throttles the occluded window and the PiP goes blank).
EXTRA=(
  --ozone-platform=x11
  --remote-debugging-address=127.0.0.1
  --remote-debugging-port=9224
  --remote-allow-origins=*
  --disable-backgrounding-occluded-windows
  --disable-renderer-backgrounding
  --disable-background-timer-throttling
)

have_app() {
  local scope="$1"
  if [ "$scope" = user ]; then
    [ -d "${HOME}/.local/share/flatpak/app/${APP}" ] && return 0
    flatpak info --user "${APP}" >/dev/null 2>&1 && return 0
  else
    [ -d "/var/lib/flatpak/app/${APP}" ] && return 0
    flatpak info --system "${APP}" >/dev/null 2>&1 && return 0
  fi
  return 1
}

if ! command -v flatpak >/dev/null 2>&1; then
  echo "vtpip-run: flatpak is not installed" >&2
  exit 1
fi

if have_app user; then
  exec flatpak run --user "${APP}" "${EXTRA[@]}" "$@"
fi
if have_app system; then
  exec flatpak run "${APP}" "${EXTRA[@]}" "$@"
fi

echo "vtpip-run: ${APP} is not installed. Open VTPiP in the Quick Access Menu to install it." >&2
exit 1
